PORT=5000

# Same cluster / database the client uses (BetterAuth stores users here too)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=booknook

# Must be IDENTICAL to JWT_SECRET in the client's .env.local
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed browser origins (your client URLs)
CLIENT_URL=http://localhost:3000
